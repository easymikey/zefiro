# zefiro-ui.toml
[cover]
# the noir look
mode = "milkdrop"
brackets = true

[card]
format_chips = true
speed_chip = "always"

[progress]
remaining = true

[window]
key_hints = false
animations = false

[layout]
mode = "compact"
