---
source: crates/config/src/config_file.rs
expression: config
---
ConfigFile {
    music_dir: None,
    theme: "auto",
    volume: 50,
    audio: AudioConfig {
        crossfade: Crossfade(
            0ns,
        ),
        replaygain: Off,
        device: None,
        sleep_presets: [
            900s,
            1800s,
            3600s,
        ],
    },
    keymap: {
        "next": KeyBindingFile {
            chord: "not-a-key",
            context: Global,
        },
    },
}
