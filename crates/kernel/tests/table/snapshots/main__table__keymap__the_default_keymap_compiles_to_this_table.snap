---
source: crates/kernel/tests/table/keymap.rs
expression: "rendered.join(\"\\n\")"
---
Global         Space            Playback(Toggle)
Global         n                Playback(Next)
Global         p                Playback(Previous)
Global         h                Playback(SeekBy { direction: Previous, by: 10s })
Global         l                Playback(SeekBy { direction: Next, by: 10s })
Global         ←                Playback(SeekBy { direction: Previous, by: 5s })
Global         →                Playback(SeekBy { direction: Next, by: 5s })
Global         Shift+←          Playback(SeekBy { direction: Previous, by: 30s })
Global         Shift+→          Playback(SeekBy { direction: Next, by: 30s })
Global         +                Playback(StepVolume(Next))
Global         =                Playback(StepVolume(Next))
Global         -                Playback(StepVolume(Previous))
Global         _                Playback(StepVolume(Previous))
Global         s                Playback(ToggleShuffle)
Global         r                Playback(CycleRepeat)
Global         z                Playback(CycleSleep)
Global         b                Playback(AbMark)
Global         [                Playback(StepSpeed(Previous))
Global         ]                Playback(StepSpeed(Next))
Global         Ctrl+J           Overlay(Open(JumpToTime))
Playlist       j                Browse(CursorBy { rows: 1 })
Playlist       ↓                Browse(CursorBy { rows: 1 })
Playlist       k                Browse(CursorBy { rows: -1 })
Playlist       ↑                Browse(CursorBy { rows: -1 })
Playlist       gg               Browse(Top)
Playlist       Home             Browse(Top)
Playlist       G                Browse(Bottom)
Playlist       End              Browse(Bottom)
Playlist       PgDn             Browse(PageBy(Next))
Playlist       Ctrl+D           Browse(PageBy(Next))
Playlist       PgUp             Browse(PageBy(Previous))
Playlist       Ctrl+U           Browse(PageBy(Previous))
Playlist       Enter            Browse(PlaySelected)
Playlist       a                Queue(Enqueue)
Playlist       A                Queue(PlayNext)
Playlist       x                Queue(Dequeue)
Playlist       Shift+↑          Queue(MoveInQueue(Previous))
Playlist       Shift+↓          Queue(MoveInQueue(Next))
Playlist       o                Browse(CycleSort)
Playlist       f                Browse(ToggleFavorite)
Playlist       d                Overlay(Open(ConfirmDelete))
Playlist       S                Overlay(Open(SavePlaylist))
Playlist       R                Browse(FullScan)
Playlist       i                Overlay(Open(TrackDetails))
Global         /                Overlay(Open(Search))
Global         H                Overlay(Open(History))
Global         ,                Overlay(Open(Settings))
Settings       j                Overlay(Settings(Navigate(Next)))
Settings       ↓                Overlay(Settings(Navigate(Next)))
Settings       k                Overlay(Settings(Navigate(Previous)))
Settings       ↑                Overlay(Settings(Navigate(Previous)))
Settings       h                Overlay(Settings(Step(Previous)))
Settings       ←                Overlay(Settings(Step(Previous)))
Settings       l                Overlay(Settings(Step(Next)))
Settings       →                Overlay(Settings(Step(Next)))
Settings       Enter            Overlay(Settings(Activate))
Settings       Space            Overlay(Settings(Activate))
Settings       Esc              Overlay(Close)
Global         L                Overlay(Open(MusicDir))
Global         ?                Overlay(Open(Help))
Global         Ctrl+K           Overlay(Open(Help))
Global         q                Quit
Global         0                Playback(SeekTenths(SeekTenths(0)))
Global         1                Playback(SeekTenths(SeekTenths(1)))
Global         2                Playback(SeekTenths(SeekTenths(2)))
Global         3                Playback(SeekTenths(SeekTenths(3)))
Global         4                Playback(SeekTenths(SeekTenths(4)))
Global         5                Playback(SeekTenths(SeekTenths(5)))
Global         6                Playback(SeekTenths(SeekTenths(6)))
Global         7                Playback(SeekTenths(SeekTenths(7)))
Global         8                Playback(SeekTenths(SeekTenths(8)))
Global         9                Playback(SeekTenths(SeekTenths(9)))
TextPrompt     Enter            Overlay(Confirm)
TextPrompt     Esc              Overlay(Close)
TextPrompt     Backspace        Overlay(Text(Backspace))
Search         Ctrl+U           Overlay(Search(Edit(Clear)))
Search         Ctrl+W           Overlay(Search(Edit(DeleteWord)))
Search         Alt+Backspace    Overlay(Search(Edit(DeleteWord)))
Search         Super+Backspace  Overlay(Search(Edit(Clear)))
Search         Esc              Overlay(Close)
Search         Enter            Overlay(Confirm)
Search         Backspace        Overlay(Search(Edit(Backspace)))
Search         ↓                Overlay(Search(Navigate(Next)))
Search         ↑                Overlay(Search(Navigate(Previous)))
Search         Tab              Overlay(Search(Enqueue))
Help           Esc              Overlay(Close)
Help           q                Quit
Help           Ctrl+K           Overlay(Close)
History        gg               Overlay(History(Top))
History        Esc              Overlay(Close)
History        Enter            Overlay(History(Enqueue))
History        j                Overlay(History(Navigate(Next)))
History        ↓                Overlay(History(Navigate(Next)))
History        k                Overlay(History(Navigate(Previous)))
History        ↑                Overlay(History(Navigate(Previous)))
History        G                Overlay(History(Bottom))
ConfirmDelete  y                Overlay(Confirm)
ConfirmDelete  Enter            Overlay(Confirm)
ConfirmDelete  n                Overlay(Close)
ConfirmDelete  Esc              Overlay(Close)
JumpToTime     Esc              Overlay(Close)
JumpToTime     Enter            Overlay(Confirm)
JumpToTime     Backspace        Overlay(Jump(Backspace))
JumpToTime     0                Overlay(Jump(Char('0')))
JumpToTime     1                Overlay(Jump(Char('1')))
JumpToTime     2                Overlay(Jump(Char('2')))
JumpToTime     3                Overlay(Jump(Char('3')))
JumpToTime     4                Overlay(Jump(Char('4')))
JumpToTime     5                Overlay(Jump(Char('5')))
JumpToTime     6                Overlay(Jump(Char('6')))
JumpToTime     7                Overlay(Jump(Char('7')))
JumpToTime     8                Overlay(Jump(Char('8')))
JumpToTime     9                Overlay(Jump(Char('9')))
JumpToTime     :                Overlay(Jump(Char(':')))
TrackDetails   any key          Overlay(Close)
